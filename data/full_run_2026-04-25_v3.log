data: {"ts": "2026-04-25T18:18:04.199225+00:00", "agent": "pipeline", "kind": "done", "message": "Investigation complete: 2 Minister-ready briefs", "payload": {"briefs": [{"loop_id": 2096, "lead_number": 31213359, "lead_unit": "dollars", "lead_sentence": "$31,213,359 flowed through a 5-charity cross-provincial DAF cycle between 2022 and 2023, dominated by a single $20,667,249 transfer from Cidel Foundation \u2014 a small Calgary foundation with only $3,514,036 in 2023 revenue \u2014 to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada.", "named_entities": ["WEST VANCOUVER COMMUNITY FOUNDATION", "TORONTO FOUNDATION", "Cidel Foundation", "Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada", "GIVEWISE FOUNDATION CANADA"], "mechanism": "TORONTO FOUNDATION transferred $9,035,685 to Cidel Foundation across 2022 ($7,314,649) and 2023 ($1,721,036); Cidel Foundation then forwarded $20,667,249 \u2014 approximately 5.9\u00d7 its own 2023 revenue of $3,514,036 \u2014 to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada in a single 2023 transaction, suggesting Cidel is acting as a pass-through aggregator rather than an independent grantmaker. The cycle closes nominally via Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada \u2192 GIVEWISE FOUNDATION CANADA ($10,000 in 2022) \u2192 WEST VANCOUVER COMMUNITY FOUNDATION ($1,000,425 in 2022) \u2192 TORONTO FOUNDATION ($500,000 in 2023), though these trailing edges are small relative to the dominant Cidel leg and may be incidental DAF platform activity.", "recommendation": "Trigger a CRA T3010 audit on Cidel Foundation (BN 836725820RR0001) for FY 2022\u20132023, specifically requiring production of all donor-advised fund account records and grant authorization documentation to verify that the $20,667,249 outflow to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada reflects genuine donor direction rather than discretionary re-routing by Cidel's three trustees, including CIDEL TRUST COMPANY.", "evidence_refs": {"total_flow": 31213359, "charity_count": 5, "shared_director_count": 0, "external_fed_ab_total": 65392234, "year_range": [2022, 2023]}, "verdict": "medium_concern", "verifications": [{"tool": "verify_gift", "subject": "Cidel\u2192CGFCF 2023 transfer ($20,667,249)", "verified": true, "details": "Exact match: actual=$20,667,249, delta=0.0%. Single source row confirmed."}, {"tool": "verify_gift", "subject": "Toronto Foundation\u2192Cidel multi-year total ($9,035,685, 2022+2023)", "verified": true, "details": "Source rows: $7,314,649 (2022) + $1,721,036 (2023) = $9,035,685 exactly. Individual-year probes failed as expected (full total tested against single year); aggregate is confirmed via direct DB query."}, {"tool": "verify_charity_revenue", "subject": "CGFCF 2023 revenue ($442,024,322)", "verified": false, "details": "Actual revenue (field_4700) = $613,336,251 \u2014 dossier understates by 38.8%. CGFCF is even larger than represented; does not change loop structure but undermines dossier accuracy."}, {"tool": "verify_external_funding", "subject": "Toronto Foundation federal funding ($65,382,543)", "verified": true, "details": "Actual=$65,198,364, delta=-0.28%. However, funding dates to 2014\u20132015 only \u2014 not contemporaneous with the 2022\u20132023 cycle activity."}], "risk_score": 58, "score_breakdown": {"dollar_magnitude": 25, "cycle_tightness": 10, "director_overlap": 0, "govt_funding": 14, "independence": 9}}, {"loop_id": 5187, "lead_number": 30463674, "lead_unit": "dollars", "lead_sentence": "$30,463,674 flowed through a 6-charity cross-provincial loop between 2020 and 2023, with $20,667,249 ultimately aggregating at Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada via a Calgary-based captive trust.", "named_entities": ["WEST VANCOUVER COMMUNITY FOUNDATION", "TORONTO FOUNDATION", "Cidel Foundation", "Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada", "COMOX VALLEY LAND TRUST", "VANCITY COMMUNITY FOUNDATION"], "mechanism": "Toronto Foundation directed $9,035,685 to Cidel Foundation across 2022\u20132023 (including a verified $7,314,649 single transfer in 2022 representing ~48% of Toronto Foundation's 2022 revenue of $15,116,436); Cidel Foundation then transferred $20,667,249 to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada in 2023 \u2014 an amount 7.4\u00d7 Cidel's 2023 revenue of $3,514,036 and representing virtually its entire 2023 expense base of $26,086,078. The loop closes through small downstream grants from Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada to COMOX VALLEY LAND TRUST ($28,500), then VANCITY COMMUNITY FOUNDATION ($212,755), then WEST VANCOUVER COMMUNITY FOUNDATION ($15,485), and finally back to TORONTO FOUNDATION ($500,000), with Cidel Foundation \u2014 governed by only three trustees including the corporate trustee CIDEL TRUST COMPANY \u2014 acting as a high-velocity pass-through that amplifies inflows by drawing on accumulated reserves.", "recommendation": "Trigger a CRA T3010 audit on Cidel Foundation (BN 836725820RR0001) and Toronto Foundation (BN 136491875RR0001) for FY 2022\u20132023, specifically requiring Cidel Foundation to produce donor-advised fund account records and gift agreements substantiating the purpose and ultimate beneficiaries of the $20,667,249 transfer to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada.", "evidence_refs": {"total_flow": 30463674.0, "charity_count": 6, "shared_director_count": 0, "external_fed_ab_total": 107933890.71, "year_range": [2020, 2023]}, "verdict": "medium_concern", "verifications": [{"tool": "verify_gift", "subject": "Cidel Foundation \u2192 CGF Canada 2023 transfer ($20.67M)", "verified": true, "details": "Exact match: actual=$20,667,249, delta=0.0%. Single CRA record confirmed."}, {"tool": "verify_gift", "subject": "Toronto Foundation \u2192 Cidel Foundation 2022 transfer ($7.31M)", "verified": true, "details": "Exact match: actual=$7,314,649, delta=0.0%. Single CRA record confirmed."}, {"tool": "verify_gift", "subject": "West Vancouver CF \u2192 Toronto Foundation 2023 transfer ($500K)", "verified": true, "details": "Exact match: actual=$500,000, delta=0.0%. Single CRA record confirmed."}, {"tool": "verify_external_funding", "subject": "Toronto Foundation federal funding ($65.4M claimed)", "verified": true, "details": "Actual=$65,198,364 via legal_name match, delta=-0.28%. Grants dated 2014\u20132015 only \u2014 not concurrent with loop activity."}, {"tool": "verify_external_funding", "subject": "Vancity Community Foundation federal funding ($39.0M claimed)", "verified": true, "details": "Actual=$36,965,820 via BN match, delta=-5.31% (within 10% tolerance). Grants dated 2018\u20132019 \u2014 not concurrent with loop activity."}], "risk_score": 54, "score_breakdown": {"dollar_magnitude": 24, "cycle_tightness": 8, "director_overlap": 0, "govt_funding": 17, "independence": 5}}]}}

