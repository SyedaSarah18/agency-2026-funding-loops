data: {"ts": "2026-04-25T16:56:08.446794+00:00", "agent": "pipeline", "kind": "done", "message": "Investigation complete: 2 Minister-ready briefs", "payload": {"briefs": [{"loop_id": 5186, "lead_number": 30712764, "lead_unit": "dollars", "lead_sentence": "$30,712,764 circulated through a 6-charity perfect ring spanning British Columbia, Ontario, and Alberta between 2020 and 2024, with $65,382,543 in federal grants entering the cycle via Toronto Foundation.", "named_entities": ["TORONTO FOUNDATION", "Cidel Foundation", "Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada", "GIVEWISE FOUNDATION CANADA", "Nicola Wealth Private Giving Foundation", "WEST VANCOUVER COMMUNITY FOUNDATION"], "mechanism": "Toronto Foundation \u2014 recipient of $65,382,543 in federal grants \u2014 disbursed $9,035,685 to Cidel Foundation (Calgary) across 2022\u20132023; Cidel then routed $20,667,249 to Charitable Gift Funds Canada Foundation in a single 2023 transfer that was 7.4\u00d7 Cidel's own 2023 revenue of $3,514,036, indicating prior-year fund accumulation and deliberate re-routing. Funds then passed in sharply diminishing tranches through GIVEWISE FOUNDATION CANADA (controlled at the Treasurer and Secretary level by non-arm's-length family members MARK BRANDSMA and TAMMY BRANDSMA) and Nicola Wealth Private Giving Foundation before closing the ring back to WEST VANCOUVER COMMUNITY FOUNDATION, whose 2023 expenses of $4,983,149 were 3.2\u00d7 its 2023 revenue of $1,562,817. Five additional cross-edges and reverse transfers \u2014 including a $1,000,425 GiveWise-to-West Vancouver CF shortcut, a $508,791 Charitable Gift Funds Canada-to-West Vancouver CF shortcut, and a $114,500 reverse edge from Charitable Gift Funds Canada back to Toronto Foundation \u2014 create a dense obfuscation sub-graph; the recipient on the Charitable Gift Funds Canada\u2013to\u2013GiveWise edge was recorded as 'GiveClear Foundation' rather than GIVEWISE FOUNDATION CANADA, further obscuring fund flow.", "recommendation": "Trigger CRA T3010 audits on all 6 charities for fiscal years 2020\u20132024, with priority examination of Cidel Foundation's multi-year fund accumulation and $20,667,249 disbursement, GIVEWISE FOUNDATION CANADA's non-arm's-length governance by MARK BRANDSMA and TAMMY BRANDSMA, and Toronto Foundation's $9,035,685 transfer to Cidel against its $65,382,543 federal grant receipts; simultaneously refer the 'GiveClear Foundation' donee name discrepancy to CRA's Charities Directorate for identity verification.", "evidence_refs": {"total_flow": 30712764.0, "charity_count": 6, "shared_director_count": 0, "external_fed_ab_total": 65402371.0, "year_range": [2020, 2024]}, "verdict": "high_concern"}, {"loop_id": 2096, "lead_number": 31212359, "lead_unit": "dollars", "lead_sentence": "$31,212,359 flowed through a structurally perfect 5-node ring across 4 cities and 3 provinces between 2022 and 2023, with Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada emerging as the net accumulation point (+$20,657,249) and the loop-closing node governed by a non-arms-length spousal pair.", "named_entities": ["WEST VANCOUVER COMMUNITY FOUNDATION", "TORONTO FOUNDATION", "Cidel Foundation", "Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada", "GIVEWISE FOUNDATION CANADA"], "mechanism": "WEST VANCOUVER COMMUNITY FOUNDATION seeded the ring with a $500,000 grant to TORONTO FOUNDATION (FY2023), which then disbursed $9,035,685 to Cidel Foundation across FY2022\u20132023; Cidel Foundation \u2014 governed by only three trustees including a corporate trustee \u2014 passed the single largest hop of $20,667,249 (66% of total flow) to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada in FY2023. Charitable Gift Funds Canada Foundation then transferred $10,000 to GIVEWISE FOUNDATION CANADA (recorded under the name 'GiveClear Foundation' in source data), and GIVEWISE FOUNDATION CANADA \u2014 whose Chair/Treasurer MARK BRANDSMA and Secretary TAMMY BRANDSMA are both flagged non-arms-length \u2014 closed the ring by granting $1,000,425 back to WEST VANCOUVER COMMUNITY FOUNDATION in FY2022, completing the cycle.", "recommendation": "Trigger CRA T3010 audits on all 5 charities for FY2022\u20132023, with priority examination of Cidel Foundation's $20,667,249 disbursement authorization, the $10,000 transfer recorded under the mismatched donee name 'GiveClear Foundation', and GIVEWISE FOUNDATION CANADA's non-arms-length governance by MARK BRANDSMA and TAMMY BRANDSMA at the structurally critical loop-closing node.", "evidence_refs": {"total_flow": 31212359, "charity_count": 5, "shared_director_count": 0, "external_fed_ab_total": 65402271, "year_range": [2022, 2023]}, "verdict": "medium_concern"}]}}

