data: {"ts": "2026-04-25T17:58:06.358605+00:00", "agent": "pipeline", "kind": "done", "message": "Investigation complete: 2 Minister-ready briefs", "payload": {"briefs": [{"loop_id": 2096, "lead_number": 31213359, "lead_unit": "dollars", "lead_sentence": "$31,213,359 circulated across a 5-charity, 3-province loop between 2022 and 2023, anchored by a single $20,667,249 transfer from a minimally-governed Calgary trust foundation to a major donor-advised fund vehicle.", "named_entities": ["Cidel Foundation", "Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada", "TORONTO FOUNDATION", "GIVEWISE FOUNDATION CANADA", "WEST VANCOUVER COMMUNITY FOUNDATION"], "mechanism": "Toronto Foundation (ON) transferred $9,035,685 to Cidel Foundation (AB) over 2022\u20132023; Cidel Foundation then sent $20,667,249 in a single 2023 transaction to Charitable Gift Funds Canada Foundation (ON), representing 66% of total loop flow and originating from an entity governed by only 3 trustees including a corporate trustee (Cidel Trust Company) with no staff data on record. Charitable Gift Funds Canada Foundation passed $10,000 to GIVEWISE FOUNDATION CANADA (BC), which in turn sent $1,000,425 to WEST VANCOUVER COMMUNITY FOUNDATION (BC, zero full-time employees), which closed the loop with a $500,000 transfer back to Toronto Foundation \u2014 though the $10,000 edge is 2,000x smaller than the dominant edge and may be incidental rather than coordinated.", "recommendation": "Trigger a CRA T3010 audit on Cidel Foundation (BN 836725820RR0001) and GIVEWISE FOUNDATION CANADA (BN 701032526RR0001) for FY 2022\u20132023, specifically requiring production of donor instruction records underlying the $20,667,249 Cidel-to-CGFCF transfer and a governance review of the non-arm's-length Brandsma family pair (Treasurer and Secretary) at GiveWise.", "evidence_refs": {"total_flow": 31213359, "charity_count": 5, "shared_director_count": 0, "external_fed_ab_total": 65208192, "year_range": [2022, 2023]}, "verdict": "medium_concern"}, {"loop_id": 5187, "lead_number": 30459674, "lead_unit": "dollars", "lead_sentence": "$30,459,674 flowed across a 6-charity cycle spanning BC, ON, and AB between 2020 and 2023, dominated by a single verified $20,667,249 transfer from Cidel Foundation to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada in 2023.", "named_entities": ["WEST VANCOUVER COMMUNITY FOUNDATION", "TORONTO FOUNDATION", "Cidel Foundation", "Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada", "COMOX VALLEY LAND TRUST", "VANCITY COMMUNITY FOUNDATION"], "mechanism": "The cycle runs: WEST VANCOUVER COMMUNITY FOUNDATION paid $500,000 to TORONTO FOUNDATION (2023); TORONTO FOUNDATION paid $9,035,685 to Cidel Foundation (2022\u20132023, though year-split attribution in the dossier is materially unreliable \u2014 verified combined total matches but individual year figures failed verification by margins of -19% and -81%); Cidel Foundation then disbursed $20,667,249 to Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada in a single 2023 transfer (independently verified at exact match). The remaining closing edges \u2014 Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada to COMOX VALLEY LAND TRUST ($28,500 over 2020\u20132022), COMOX VALLEY LAND TRUST to VANCITY COMMUNITY FOUNDATION ($212,755 in 2023), and VANCITY COMMUNITY FOUNDATION back to WEST VANCOUVER COMMUNITY FOUNDATION ($15,485 in 2022\u20132023) \u2014 are trivially small relative to the dominant Cidel leg and are consistent with routine grant-making. Net flow analysis identifies Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada as the dominant accumulator (+$20,638,749 net) and Cidel Foundation as the dominant distributor (-$11,631,564 net), suggesting terminus rather than pass-through behaviour.", "recommendation": "Trigger a CRA T3010 audit of Cidel Foundation and Charitable Gift Funds Canada Foundation / Fonds de Bienfaisance Canada for FY 2022\u20132023, focusing specifically on the purpose, donor identity, and ultimate charitable use of the $20,667,249 single-year transfer, and require TORONTO FOUNDATION to provide corrected year-by-year disbursement records to resolve the $9,035,685 edge misattribution identified in verification.", "evidence_refs": {"total_flow": 30459674.0, "charity_count": 6, "shared_director_count": 0, "external_fed_ab_total": 107533891.71, "year_range": [2020, 2023]}, "verdict": "medium_concern"}]}}

